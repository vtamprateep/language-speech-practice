    {
        "id": 1,
        "title": "Basic sentence order: Subject + Verb (+ Object)",
        "description": "The basic Chinese sentence structure is Subject + Verb + Object.",
        "examples": [
            "我愛你。 (Wǒ ài nǐ.) — I love you.",
            "他吃蘋果。 (Tā chī píngguǒ.) — He eats an apple."
